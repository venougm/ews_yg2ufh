# EWS backend configuration (.env). Copy to .env and edit.
#
# ANTI-CONFLICT with the live APRS backend on ews.example.com:8000:
# EWS MUST use DIFFERENT resources so it never collides with APRS on the shared
# broker. A shared MQTT_CLIENT_ID in particular would kick APRS off the broker.
#   - MQTT_CLIENT_ID   = ews-web-backend   (NOT the APRS client id)
#   - MQTT_TOPIC_PREFIX= yg2ufh/ews        (subscribes yg2ufh/ews/#)
#   - HTTP_PORT        = 8001              (APRS owns 8000)
#   - DB_PATH          = ./data/ews.db     (separate database file)

# Required (no safe default): the MQTT broker host and topic prefix.
MQTT_BROKER_HOST=ews.example.com
MQTT_TOPIC_PREFIX=yg2ufh/ews

# Optional (shown with their defaults).
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ews-web-backend
# MQTT_USERNAME=
# MQTT_PASSWORD=

DB_PATH=./data/ews.db
HTTP_HOST=0.0.0.0
HTTP_PORT=8001
LOG_LEVEL=INFO

# History default window (hours) when a node-history request omits ?hours=.
HISTORY_LOOKBACK_HOURS=24
# Node is flagged offline after this many seconds of silence (3x the 60s node
# interval = 180s, matching the gateway miss_threshold in the technical design).
MISS_THRESHOLD_SEC=180
# Readings older than this many days are purged (>= 12 months retention).
RETENTION_DAYS=365

# --- Auth 'Tingkat A' ------------------------------------------------------
# Signed-cookie session secret. Set a LONG random value in production; if left
# empty an ephemeral dev secret is generated at startup (sessions drop on restart).
SESSION_SECRET=
# The admin username seeded on first startup (empty users table).
EWS_ADMIN_USER=admin
# Admin password seeded on first startup. If EMPTY, a random password is LOGGED
# ONCE at startup -- copy it from the logs (it is never shown again).
# EWS_ADMIN_PASSWORD=
# Seed demo 'operator' and 'monitor' users (password = username). true ONLY for
# UI role testing -- NEVER in production.
EWS_SEED_DEMO_USERS=false
# Mark the session cookie Secure (HTTPS-only). True ONLY when served behind HTTPS;
# keep false for plain-HTTP local testing.
COOKIE_SECURE=false
