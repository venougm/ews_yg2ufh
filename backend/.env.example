# EWS backend configuration (.env). Copy to .env and edit.
#
# ANTI-CONFLICT with the live APRS backend on yg2ufh.mooo.com:8000:
# EWS MUST use DIFFERENT resources so it never collides with APRS on the shared
# broker. A shared MQTT_CLIENT_ID in particular would kick APRS off the broker.
#   - MQTT_CLIENT_ID   = ews-web-backend   (NOT the APRS client id)
#   - MQTT_TOPIC_PREFIX= yg2ufh/ews        (subscribes yg2ufh/ews/#)
#   - HTTP_PORT        = 8001              (APRS owns 8000)
#   - DB_PATH          = ./data/ews.db     (separate database file)

# Required (no safe default): the MQTT broker host and topic prefix.
MQTT_BROKER_HOST=yg2ufh.mooo.com
MQTT_TOPIC_PREFIX=yg2ufh/ews

# Optional (shown with their defaults).
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=ews-web-backend
# MQTT_USERNAME=
# MQTT_PASSWORD=

DB_PATH=./data/ews.db
HTTP_HOST=0.0.0.0
HTTP_PORT=8001
LOG_LEVEL=INFO

# History default window (hours) when a node-history request omits ?hours=.
HISTORY_LOOKBACK_HOURS=24
# Node is flagged offline after this many seconds of silence (3x the 60s node
# interval = 180s, matching the gateway miss_threshold in the technical design).
MISS_THRESHOLD_SEC=180
# Readings older than this many days are purged (>= 12 months retention).
RETENTION_DAYS=365
